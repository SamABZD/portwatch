# Copy to .env for local overrides. These values are for a localhost demo only.
# The same DB fields are read by Compose and by the Python CLI.
PORTWATCH_DB_HOST=127.0.0.1
PORTWATCH_DB_PORT=5432
PORTWATCH_DB_NAME=portwatch
PORTWATCH_DB_USER=portwatch
PORTWATCH_DB_PASSWORD=portwatch_dev_only
PORTWATCH_DB_SSLMODE=prefer

# Paths may be absolute or relative to the PortWatch project root.
PORTWATCH_RAW_DIR=data/raw
PORTWATCH_DERIVED_DIR=data/derived
PORTWATCH_DEMO_CONFIG=configs/demo.yaml
PORTWATCH_QUARANTINE_DIR=data/quarantine
PORTWATCH_PORT_CONFIG=configs/ports/los_angeles.yaml

# Optional. Leave unset for the historical replay demo.
# PORTWATCH_AIS_API_KEY=

# Live collector: bounded queue, frequent durable flush, short batch rotation.
PORTWATCH_LIVE_SPOOL_DIR=data/live-spool
PORTWATCH_LIVE_STATUS_DIR=artifacts/live
PORTWATCH_LIVE_QUEUE_RECORDS=128
PORTWATCH_LIVE_ROTATE_SECONDS=30
PORTWATCH_LIVE_ROTATE_BYTES=1048576
PORTWATCH_LIVE_FLUSH_SECONDS=1

# Optional health warning thresholds; do not delete raw files automatically.
PORTWATCH_HEALTH_STATUS_STALE_SECONDS=60
PORTWATCH_HEALTH_OBSERVATION_STALE_SECONDS=300
PORTWATCH_HEALTH_BACKLOG_WARN_SECONDS=120
PORTWATCH_HEALTH_CONTEXT_STALE_SECONDS=7200
PORTWATCH_STORAGE_MIN_FREE_BYTES=1073741824
