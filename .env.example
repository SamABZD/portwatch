# Copy to .env for local overrides. These values are for a localhost demo only.
# The same DB fields are read by Compose and by the Python CLI.
PORTWATCH_DB_HOST=127.0.0.1
PORTWATCH_DB_PORT=5432
PORTWATCH_DB_NAME=portwatch
PORTWATCH_DB_USER=portwatch
PORTWATCH_DB_PASSWORD=portwatch_dev_only

# Paths may be absolute or relative to the PortWatch project root.
PORTWATCH_RAW_DIR=data/raw
PORTWATCH_PORT_CONFIG=configs/ports/los_angeles.yaml

# Optional. Leave unset for the historical replay demo.
# PORTWATCH_AIS_API_KEY=
